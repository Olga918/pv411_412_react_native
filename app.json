{
  "expo": {
    "name": "React Native Lessons",
    "slug": "react_native_lessons",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/ourIcon/our_icon.png",
    "scheme": "pv411412reactnative",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#741B7C",
        "foregroundImage": "./assets/images/ourIcon/our_icon_foreground.png",
        "backgroundImage": "./assets/images/ourIcon/our_icon_background.png",
        "monochromeImage": "./assets/images/ourIcon/our_icon_monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#741B7C",
          "image": "./assets/images/ourIcon/our_splash_icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/favicon.png",
          "color": "#6d0d31f5"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access for flashlight homework"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
